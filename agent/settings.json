{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "github-copilot/gpt-5.6-luna:medium",
    "github-copilot/gpt-5.6-sol:medium",
    "github-copilot/gpt-5.6-terra:medium",
    "openai-codex/gpt-5.6-sol:medium",
    "openai-codex/gpt-5.6-terra:high",
    "openai-codex/gpt-5.6-luna:high",
    "opencode-go/deepseek-v4-flash:high",
    "opencode-go/kimi-k2.7-code:high",
    "opencode-go/minimax-m3:high"
  ],
  "editorPaddingX": 2,
  "hideThinkingBlock": true,
  "packages": [
    "git:github.com/DietrichGebert/ponytail",
    "npm:@ff-labs/pi-fff",
    "git:github.com/code-yeongyu/pi-apply-patch",
    "npm:@plannotator/pi-extension"
  ],
  "skills": [
    "~/dotfiles/skills"
  ],
  "extensions": [
    "~/dotfiles/pi/agent/extensions"
  ],
  "prompts": [
    "~/dotfiles/pi/agent/prompts"
  ],
  "subagents": {
    "preset": "copilot",
    "presets": {
      "personal": {
        "scout": {
          "model": "opencode-go/deepseek-v4-flash",
          "thinking": "medium"
        },
        "review": {
          "model": "openai-codex/gpt-5.6-sol",
          "thinking": "high",
          "skills": [
            "*"
          ]
        },
        "commit": {
          "model": "opencode-go/deepseek-v4-flash",
          "thinking": "medium",
          "skills": [
            "~/dotfiles/skills/commit-work"
          ]
        },
        "agent": {
          "enabled": false,
          "routes": [
            {
              "model": "opencode-go/deepseek-v4-flash",
              "thinking": "medium",
              "guidance": "reconnaissance/routine checks"
            },
            {
              "model": "opencode-go/kimi-k2.7-code",
              "thinking": "high",
              "guidance": "routine or clearly scoped implementation"
            },
            {
              "model": "openai-codex/gpt-5.6-sol",
              "thinking": "medium",
              "guidance": "difficult implementation, ambiguous behavior, architecture-sensitive changes, or hard debugging"
            },
            {
              "model": "openai-codex/gpt-5.6-sol",
              "thinking": "high",
              "guidance": "consequential planning, adversarial review, security, or data-loss work"
            }
          ]
        }
      },
      "opencode-go": {
        "scout": {
          "model": "opencode-go/deepseek-v4-flash",
          "thinking": "medium"
        },
        "review": {
          "model": "opencode-go/glm-5.2",
          "thinking": "high",
          "skills": [
            "*"
          ]
        },
        "commit": {
          "model": "opencode-go/kimi-k2.7-code",
          "thinking": "high",
          "skills": [
            "~/dotfiles/skills/commit-work"
          ]
        },
        "agent": {
          "enabled": false,
          "routes": [
            {
              "model": "opencode-go/deepseek-v4-flash",
              "thinking": "medium",
              "guidance": "reconnaissance/routine checks"
            },
            {
              "model": "opencode-go/kimi-k2.7-code",
              "thinking": "high",
              "guidance": "routine or clearly scoped implementation"
            },
            {
              "model": "opencode-go/kimi-k3",
              "thinking": "max",
              "guidance": "planning or consequential final review"
            }
          ]
        }
      },
      "openai": {
        "scout": {
          "model": "openai-codex/gpt-5.6-luna",
          "thinking": "low"
        },
        "review": {
          "model": "openai-codex/gpt-5.6-sol",
          "thinking": "high",
          "skills": [
            "*"
          ]
        },
        "commit": {
          "model": "openai-codex/gpt-5.6-terra",
          "thinking": "medium",
          "skills": [
            "~/dotfiles/skills/commit-work"
          ]
        },
        "agent": {
          "enabled": false,
          "routes": [
            {
              "model": "openai-codex/gpt-5.6-luna",
              "thinking": "low",
              "guidance": "reconnaissance/routine checks"
            },
            {
              "model": "openai-codex/gpt-5.6-terra",
              "thinking": "medium",
              "guidance": "implementation and integration"
            },
            {
              "model": "openai-codex/gpt-5.6-sol",
              "thinking": "high",
              "guidance": "planning or consequential final review"
            }
          ]
        }
      },
      "copilot": {
        "scout": {
          "model": "github-copilot/gpt-5.6-luna",
          "thinking": "medium"
        },
        "review": {
          "model": "github-copilot/gpt-5.6-sol",
          "thinking": "high",
          "skills": [
            "*"
          ]
        },
        "commit": {
          "model": "github-copilot/gpt-5.6-luna",
          "thinking": "medium",
          "skills": [
            "~/dotfiles/skills/commit-work"
          ]
        },
        "agent": {
          "enabled": false,
          "routes": [
            {
              "model": "github-copilot/gpt-5.4-mini",
              "thinking": "medium",
              "guidance": "reconnaissance/routine checks"
            },
            {
              "model": "github-copilot/gpt-5.6-terra",
              "thinking": "medium",
              "guidance": "implementation and integration"
            },
            {
              "model": "github-copilot/gpt-5.6-sol",
              "thinking": "high",
              "guidance": "difficult planning or consequential review"
            }
          ]
        }
      }
    }
  },
  "treeFilterMode": "no-tools",
  "theme": "dark"
}
